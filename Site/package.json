{
  "name": "persian-calendar-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:vectors": "dotnet run --project ../Console -c Release -- --generate-vectors tests/fixtures/vectors.json 1200 1500",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
